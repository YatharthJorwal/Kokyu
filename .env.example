# Copy to .env (gitignored). Every value is optional and developer-only: end
# users save their API key in the app (FR-R-6, D-059). Packaged builds ignore it.

# The key of the API endpoint chosen by providers.airouter.preset in config.yaml.
# Without one, every request stays on local models.
AIROUTER_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
